# ============================================
# STUDENT DATABASE BACKEND - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to GitHub.

# Database Configuration
DATABASE_URL=mysql+pymysql://your_username:your_password@localhost:3306/student_db

# Application Settings
APP_NAME=Student Database Backend
DEBUG=True

# Gemini API (Phase 5)
GEMINI_API_KEY=your_gemini_api_key_here